# Copy to /opt/volksbanktracker/.env next to compose.yml. Never commit the real file.

Api__Key=change-me

# sqlite (default) keeps the database in the data volume at /data/tracker.db.
DB_PROVIDER=sqlite

# Required when DB_PROVIDER=postgres; startup fails without it.
# ConnectionStrings__Postgres=Host=pg.example.lan;Port=5432;Database=apps;Username=volksbank;Password=change-me;SSL Mode=Require
